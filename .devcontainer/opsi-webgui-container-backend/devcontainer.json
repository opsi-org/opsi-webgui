{
	"name": "opsi-webgui-backend-dev",
	"dockerComposeFile": "../../docker-compose.yml",
	"service": "opsi-webgui-backend-dev",
	"runServices": [
		"opsi-webgui-frontend-dev",
		"opsi-server",
		"mysql",
		"redis",
		"grafana"
	],
	"initializeCommand": ".devcontainer/opsi-webgui-container-backend/initialize.sh",
	"postCreateCommand": ".devcontainer/opsi-webgui-container-backend/post_create.sh",
	"postStartCommand": ".devcontainer/opsi-webgui-container-backend/post_start.sh",
	"workspaceFolder": "/workspace",
	"remoteEnv": {
		//"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
		"DEV_USER": "${localEnv:USER}",
		"DEV_UID": "${localEnv:UID}"
	},
	"customizations": {
		"codespaces": {
			"openFiles": [
				"/workspace/.vscode/launch.json",
			]
		},
		"vscode": {
			"tasks": {
				"default": "choose-main-service"
			},
			"settings": {
				"workbench.colorCustomizations": {
					"activityBar.background": "#000000",
					"activityBar.foreground": "#ff276f",
					"activityBar.inactiveForeground": "#e4e4e3"
				},
				"files.trimTrailingWhitespace": true,
				"files.autoSave": "off",
				"editor.formatOnType": true,
				"editor.formatOnPaste": true,
				"editor.formatOnSave": true,
				"[python]": {
					"editor.codeActionsOnSave": {
						"source.fixAll": true,
						"source.organizeImports": true
					},
					"editor.defaultFormatter": "charliermarsh.ruff"
				},
				"python.pythonPath": ".venv/bin/python",
				"python.languageServer": "Pylance",
				"python.terminal.activateEnvironment": false,
				"python.testing.unittestEnabled": false,
				"python.testing.nosetestsEnabled": false,
				"python.testing.pytestEnabled": true,
				"python.testing.pytestPath": ".venv/bin/pytest",
				"python.testing.pytestArgs": [
					"tests"
				],
				"pylint.severity": {
					"refactor": "Information"
				},
				"mypy-type-checker.path": [
					".venv/bin/mypy"
				],
				"mypy-type-checker.args": [
					"--show-error-codes"
				]
			},
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ryanluker.vscode-coverage-gutters",
				"ms-python.mypy-type-checker",
				"charliermarsh.ruff",
				"cweijan.dbclient-jdbc",
				"cweijan.vscode-database-client2",
				"ms-azuretools.vscode-docker",
				"docker.docker",
				"seunlanlege.action-buttons"
			]
		}
	},
	"remoteUser": "${localEnv:USER}"
}