{
  "name": "opsi-webgui",
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "opsi-webgui-dev",
  "initializeCommand": ".devcontainer/initialize.sh",
  "postCreateCommand": ".devcontainer/post_create.sh",
  "postStartCommand": ".devcontainer/post_start.sh",
  "workspaceFolder": "/workspace",
  "containerEnv": {
    "DEV_USER": "${localEnv:USER}",
    "DEV_UID": "${localEnv:UID}",
    "OPSILICSRV_URL": "${localEnv:OPSILICSRV_URL}",
    "OPSILICSRV_TOKEN": "${localEnv:OPSILICSRV_TOKEN}",
    "OPSI_TEST_LDAP_URL": "${localEnv:OPSI_TEST_LDAP_URL}",
    "ADDON_NAME": "webgui",
    "ADDON_ID": "webgui"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "files.trimTrailingWhitespace": true,
        "editor.formatOnSave": true,
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          },
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "ruff.configuration": "/workspace/pyproject.toml",
        "python.defaultInterpreterPath": "/workspace/docker/opsiconfd/.venv/bin/python3",
        "python.languageServer": "Pylance",
        "python.testing.pytestEnabled": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "GitHub.copilot-chat",
        "Vue.volar",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "forwardPorts": [
    4447
  ],
  "remoteUser": "${localEnv:USER}"
}