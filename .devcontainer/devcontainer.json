{
	"name": "opsiweb",
	"dockerComposeFile": ["./docker-compose.yml"],
	"service": "opsiweb_dev",
	"runServices": ["opsiweb_dev", "opsi-server", "mysql", "redis", "grafana"],
	"workspaceFolder": "/workspace",
	"postCreateCommand": "/workspace/.devcontainer/post_create.sh",
