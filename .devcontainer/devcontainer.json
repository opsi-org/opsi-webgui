{
  "name": "opsi-webgui-dev",
  "dockerComposeFile": "../docker/docker-compose.yml",
  "service": "dev",
  //"runServices": ["opsi-server", "mysql", "redis", "grafana"],
  "initializeCommand": ".devcontainer/initialize.sh",
  "postCreateCommand": ".devcontainer/post_create.sh",
  "postStartCommand": ".devcontainer/post_start.sh",
  "workspaceFolder": "/workspace",
  "containerEnv": {
    "DEV_USER": "${localEnv:USER}",
    "DEV_UID": "${localEnv:UID}",
    "OPSILICSRV_URL": "${localEnv:OPSILICSRV_URL}",
    "OPSILICSRV_TOKEN": "${localEnv:OPSILICSRV_TOKEN}"
  },
  "customizations": {
    "vscode": {
      "tasks": {
        "default": "choose-main-service"
      },
      "settings": {
        "workbench.colorCustomizations": {
          "activityBar.background": "#000000",
          "activityBar.foreground": "#ff276f",
          "activityBar.inactiveForeground": "#e4e4e3"
        },
        "files.trimTrailingWhitespace": true,
        "files.autoSave": "off",
        "editor.formatOnType": true,
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.fixAll": true,
            "source.organizeImports": true
          },
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "python.pythonPath": ".venv/bin/python",
        "python.languageServer": "Pylance",
        "python.terminal.activateEnvironment": false,
        "python.testing.unittestEnabled": false,
        "python.testing.nosetestsEnabled": false,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestPath": ".venv/bin/pytest",
        "python.testing.pytestArgs": [
          "tests"
        ],
        "pylint.severity": {
          "refactor": "Information"
        },
        "mypy-type-checker.path": [
          ".venv/bin/mypy"
        ],
        "mypy-type-checker.args": [
          "--show-error-codes"
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ryanluker.vscode-coverage-gutters",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "cweijan.dbclient-jdbc",
        "cweijan.vscode-database-client2",
        "Postman.postman-for-vscode",
        "ms-azuretools.vscode-docker",
        "docker.docker",
        "seunlanlege.action-buttons",
        "GitHub.copilot-chat"
      ]
    }
  },
  "remoteUser": "${localEnv:USER}"
}