{
  "configurations": [
    {
      // webgui v4.4
      "name": "frontend ",
      "cwd": "${workspaceFolder}/frontend",
      "outputCapture": "std",
      "request": "launch",
      // "--dry-save-package-json-to package-merged.json",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeExecutable": "npm",
      "type": "node"
    },
    {
      "name": "opsiconfd",
      "type": "debugpy",
      "request": "launch",
      "module": "opsiconfd",
      "cwd": "${workspaceFolder}/opsiconfd",
      "args": [
        "--workers=1",
        "--log-level=5",
        "--log-level-stderr=5",
        "--log-mode=redis",
        "--static-dir=${workspaceFolder}/opsiconfd/opsiconfd_data/static"
      ],
      "sudo": true,
      "justMyCode": false
    }
  ],
  "version": "0.2.0"
}