{
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "@primevue/themes": "^4.3.9",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "5.5.0",
    "element-plus": "^2.11.4",
    "nuxt": "^3.19.2",
    "primevue": "^4.3.9",
    "tailwindcss-primeui": "^0.6.1",
    "vue3-markdown-it": "1.0.10",
    "zod": "^4.1.11"
  },
  "dependenciesComments": {
    "#node": "version > 23.0.0 seems to have issues",
    "@nuxtjs/i18n": "Using 8.5.6, cause 9.1.1 throws error in browser terminal.",
    "npm": "version > 10.9.2 currently broken ('js heap out of space' on npm run and build)"
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.1.4",
    "@histoire/plugin-nuxt": "^1.0.0-alpha.3",
    "@histoire/plugin-vue": "^1.0.0-alpha.3",
    "@iconify/vue": "^5.0.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.1.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/types": "2.18.1",
    "@nuxtjs/i18n": "^10.1.0",
    "@nuxtjs/storybook": "^9.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.2",
    "@playwright/test": "^1.56.0",
    "@primevue/nuxt-module": "^4.3.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "@volar/typescript": "^2.4.23",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "histoire": "^1.0.0-alpha.3",
    "license-checker": "25.0.1",
    "npm-check-updates": "~17.1.14",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "prettier": "^3.6.2",
    "sass": "1.82.0",
    "typescript": "5.7.3",
    "vue-tsc": "2.2.0"
  },
  "license": "AGPL-3.0",
  "name": "opsi-webgui",
  "overrides": {
    "vue": "latest"
  },
  "private": true,
  "scripts": {
    "//dev-backend": "OPSICONFD_PORT=44472 WEBGUI_DEV_PORT=8889 npm run dev",
    "bash:delete-empty-test-results": "find test-results -empty -delete",
    "check-blocked-packages": "npm audit --omit=dev --audit-level=moderate && npm ls $(tr '\\n' ' ' < package-block.txt)",
    "clean": "rm -rf node_modules",
    "clean-full": "./scripts/py-helper.sh scripts/npm-helper.py --install-clean",
    "dev": "OPSICONFD_PORT=${OPSICONFD_PORT:-44472} PORT=${WEBGUI_DEV_PORT:-8888} NODE_ENV=development echo \"$PORT ; $OPSICONFD_PORT\" && nuxi dev --host --trace-warnings",
    "dev-kill": "kill $(lsof -t -i:$WEBGUI_DEV_PORT)",
    "dev-pw": "WEBGUI_DEV_PORT=8000 npm run dev",
    "generate": "nuxi generate",
    "lint": "eslint .",
    "lint:missing-i18n": "./scripts/py-helper.sh scripts/compare_translation_keys.py -s",
    "story:build": "NODE_ENV=development histoire build",
    "story:dev": "NODE_ENV=development histoire dev",
    "story:preview": "NODE_ENV=development histoire preview",
    "sysinfo": "npx envinfo --system --npmPackages '{histoire,@histoire/*,vite,@vitejs/*}' --binaries --browsers",
    "tsc": "npx nuxi typecheck",
    "tscs": "npx nuxi typecheck --logLevel=silent",
    "versions": "./scripts/py-helper.sh scripts/npm-helper.py --versions --versions-sort is_outdated"
  },
  "type": "module",
  "version": "4.3.99.2"
}