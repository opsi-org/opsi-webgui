{
  "name": "opsi-webgui",
  "version": "4.3.99.3",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "jsonata": ">=2.2.0"
    }
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint --ext .ts,.js,.vue .",
    "lint:fix": "eslint --ext .ts,.js,.vue . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:full": "CI_PIPELINE_SOURCE=schedule playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --config tests/playwright.config.ts --ui",
    "test:e2e:update-baselines": "CI_PIPELINE_SOURCE=schedule playwright test --config tests/playwright.config.ts --update-snapshots",
    "screenshots:docs": "CI_PIPELINE_SOURCE=schedule SKIP_VISUAL_REGRESSION=1 playwright test --config tests/playwright.config.ts",
    "sbom": "cdxgen -o ../sbom.cyclonedx.json --spec-version 1.5 --type js"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^1.15.0",
    "@nuxt/ui": "^4.5.0",
    "@nuxtjs/i18n": "^10.2.3",
    "@pinia/nuxt": "^0.11.3",
    "@vueuse/core": "^14.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@cyclonedx/cdxgen": "^12.7.0",
    "@iconify-json/heroicons": "^1.2.0",
    "@iconify-json/lucide": "^1.2.0",
    "@iconify-json/simple-icons": "^1.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitest/coverage-v8": "4.1.3",
    "eslint": "^10.0.2",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuejs-accessibility": "2.5.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  }
}