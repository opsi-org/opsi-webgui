{
  "name": "opsi-webgui",
  "version": "4.3.48.15",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.8.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "setup:nuxt": "nuxt prepare",
    "lint": "eslint --ext .ts,.js,.vue .",
    "lint:fix": "eslint --ext .ts,.js,.vue . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:e2e:full": "CI_PIPELINE_SOURCE=schedule playwright test --config tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --config tests/playwright.config.ts --ui",
    "test:e2e:update-baselines": "CI_PIPELINE_SOURCE=schedule playwright test --config tests/playwright.config.ts --update-snapshots",
    "screenshots:docs": "CI_PIPELINE_SOURCE=schedule SKIP_VISUAL_REGRESSION=1 playwright test --config tests/playwright.config.ts",
    "sbom": "env -u NODE_PATH -u MYSQL_PASSWORD -u MYSQL_ROOT_PASSWORD -u MYSQL_USER -u DEV_USER -u OPSI_ADMIN_USER node ./node_modules/@cyclonedx/cdxgen/bin/cdxgen.js -o ../sbom.cyclonedx.json --spec-version 1.5 --type js --required-only --no-install-deps && node ./tools/normalize-sbom-npm-scopes.mjs --file ../sbom.cyclonedx.json --runtime-only --omit-dev --dev-scope optional --strip-dependency-risk-metadata",
    "sbom:full": "env -u NODE_PATH -u MYSQL_PASSWORD -u MYSQL_ROOT_PASSWORD -u MYSQL_USER -u DEV_USER -u OPSI_ADMIN_USER node ./node_modules/@cyclonedx/cdxgen/bin/cdxgen.js -o ../sbom.cyclonedx.json --spec-version 1.5 --type js --required-only --no-install-deps && node ./tools/normalize-sbom-npm-scopes.mjs --file ../sbom.cyclonedx.json --dev-scope optional"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "nuxt": "^4.6.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cyclonedx/cdxgen": "^12.8.5",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.140",
    "@iconify-json/simple-icons": "^1.2.99",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
