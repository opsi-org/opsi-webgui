{
  "name": "opsi-webgui",
  "version": "4.4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules; rm -f package-lock.json; npx nuxt cleanup",
    "build": "nuxi build",
    "dev0": "PORT=$WEBGUI_DEV_PORT NODE_ENV=development nuxt dev",
    "dev": "PORT=$WEBGUI_DEV_PORT NODE_ENV=development nuxi dev",
    "generate": "nuxi generate",
    "generate-with-ssl": "NODE_OPTIONS=--openssl-legacy-provider nuxt generate ",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "npx nuxi typecheck",
    "lint:all": "npx nuxi typecheck && eslint .",
    "format": "prettier --write \"{components,pages,plugins,middleware,layouts,composables,assets}/**/*.{js,jsx,ts,tsx,vue,html,css,scss,json,md}\"",
    "////nuxt-monaco-editor": "^1.2.3",
    "//monaco-editor": "^0.43.0",
    "//@vue/compat": "^3.3.4",
    "//@element-plus/icons-vue": "^2.1.0",
    "//@iconify/json": "^2.2.132",
    "//unplugin-icons": "^0.17.1",
    "//xterm": "^5.x.x",
    "//xterm-addon-fit": "^0.x.x",
    "//xterm-addon-search": "^0.x.x",
    "//xterm-addon-web-links": "^0.x.x",
    "story:dev": "NODE_ENV=development histoire dev",
    "story:build": "NODE_ENV=development histoire build",
    "story:preview": "NODE_ENV=development histoire preview",
    "pwtest:usecase": "playwright test -c tests-configs/playwright-all-usecases.config.ts",
    "pwtest:access": "playwright test -c tests-configs/playwright-all-accessibility.config.ts",
    "pwtest:components": "playwright test -c tests-configs/playwright-all-components.config.ts",
    "pwtest:components:update": "playwright test -c tests-configs/playwright-all-components.config.ts --update-snapshots",
    "bash:delete-empty-test-results": "find test-results -empty -delete",
    "//@pinia-plugin-persistedstate/nuxt": "^1.1.2",
    "//@sidebase/nuxt-auth": "^0.9.2"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0-beta2",
    "@primevue/themes": "^4.2.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "element-plus": "^2.x.x",
    "nuxt": "^3.14",
    "primevue": "^4.2.x",
    "tailwindcss-primeui": "^0.3.4",
    "vue3-markdown-it": "^1.0.10"
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.1",
    "@histoire/plugin-nuxt": "^0.17",
    "@histoire/plugin-vue": "^0.17",
    "@iconify/vue": "^4.1",
    "@nuxt/eslint": "^0.7",
    "@nuxt/types": "^2.18",
    "@nuxtjs/i18n": "^8.x",
    "@nuxtjs/storybook": "8.3",
    "@nuxtjs/tailwindcss": "^6.12",
    "@pinia/nuxt": "^0.8",
    "@playwright/test": "^1.49",
    "@primevue/nuxt-module": "^4.2.x",
    "@vitejs/plugin-vue": "^5.2",
    "@volar/typescript": "^2.4",
    "eslint": "^9.15",
    "eslint-config-prettier": "^9.1",
    "eslint-plugin-prettier": "^5.2",
    "histoire": "^0.17",
    "npm-check-updates": "^17",
    "pinia": "^2.2",
    "pinia-plugin-persistedstate": "^4.1",
    "prettier": "^3.4",
    "sass": "^1.81",
    "typescript": "5.6.2",
    "vue-tsc": "^2.1"
  },
  "dependenciesComments": {
    "typescript": "version 5.7 is incompatible with vue-tsc 2.1.0. https://github.com/vuejs/language-tools/issues/5018"
  },
  "overrides": {
    "vue": "latest"
  }
}
