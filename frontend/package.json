{
  "name": "nuxt-app",
  "version": "4.3.20",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules; rm -f package-lock.json; npx nuxt cleanup",
    "build": "nuxi build",
    "dev0": "PORT=$WEBGUI_DEV_PORT NODE_ENV=development nuxt dev",
    "dev": "PORT=$WEBGUI_DEV_PORT NODE_ENV=development nuxi dev",
    "generate": "nuxi generate",
    "//generate-with-ssl": "NODE_OPTIONS=--openssl-legacy-provider nuxt generate ",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "////nuxt-monaco-editor": "^1.2.3",
    "//monaco-editor": "^0.43.0",
    "//@vue/compat": "^3.3.4",
    "//@nuxtjs/color-mode": "^3.3.0 // currently imported by bootstrap-next ? ",
