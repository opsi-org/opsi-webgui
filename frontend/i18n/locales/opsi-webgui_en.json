      },
      "depotAccess": {
        "full": "user.{username}.privilege.host.depotaccess.configured = false → All depots accessible",
        "label": "Depot Access",
        "restricted": "user.{username}.privilege.host.depotaccess.configured = true → Only depots listed in user.{username}.privilege.host.depotaccess.depots are visible"
      },
      "hostGroupAccess": {
        "full": "user.{username}.privilege.host.groupaccess.configured = false → All host groups accessible",
        "label": "Host Groups",
        "restricted": "user.{username}.privilege.host.groupaccess.configured = true → Only groups listed in user.{username}.privilege.host.groupaccess.hostgroups are visible"
      },
      "productGroupAccess": {
        "full": "user.{username}.privilege.product.groupaccess.configured = false → All product groups accessible",
        "label": "Product Groups",
        "restricted": "user.{username}.privilege.product.groupaccess.configured = true → Only groups listed in user.{username}.privilege.product.groupaccess.productgroups are visible"
      },
      "readOnly": {
        "active": "user.{username}.privilege.host.all.registered_readonly = true → View only, no modifications allowed",
        "inactive": "user.{username}.privilege.host.all.registered_readonly = false → Full read & write access",
        "label": "Read-Only"
      },
      "serverWrite": {
        "disabled": "user.{username}.privilege.host.opsiserver.write = false → Server/depot config editing & maintenance operations are read-only",
        "enabled": "user.{username}.privilege.host.opsiserver.write = true → Can modify server configs, depot settings & maintenance operations",
        "label": "Server Write"
      },
      "title": "User Restrictions (userroles)"
    }
