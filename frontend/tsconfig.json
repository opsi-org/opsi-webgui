{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  // "compilerOptions": {
  //   "types": [
  //     // "@nuxt/types",
  //     // "monaco-editor",
  //     // "@nuxtjs/i18n"
  //     // "bootstrap-vue",
  //   ]
  // }

  "compilerOptions": {
    "outDir": "./dist",
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": true,
    "noImplicitThis": true,
    "noEmit": false, // was true
    "skipLibCheck": true,
    "resolveJsonModule": true, // locales
    "ignoreDeprecations": "5.0",
    "suppressImplicitAnyIndexErrors": true,
    "types": [
      "@pinia/nuxt",
      "@nuxtjs/i18n",
      "@nuxtjs/tailwindcss",
      "element-plus/global",
      "@bootstrap-vue-next/nuxt",
      "@iconify/vue"
    ]

  },
  // "include": [
  //   "env.d.ts",
  //   "src/**/*",
  //   "src/**/*.vue",
  //   ".nuxt/",
  //   "components/**/*.vue",
  //   "composables/**/*.vue",
  //   "layouts/**/*.vue",
  //   "plugins/**/*.vue",
  // ]
}
