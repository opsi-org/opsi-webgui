{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "opsiconfd uv",
			"outputCapture": "std",
			"request": "launch",
			// "--dry-save-package-json-to package-merged.json",
			"runtimeArgs": [
				"-E",
				"/root/.local/bin/uv",
				"run",
				"-m",
				"opsiconfd",
				"--workers=1",
				"--log-mode=redis",
				"--log-level-stderr=5",
				"--addon-dirs=/workspace/addon",
				"--static-dir=/workspace/docker/backend/opsiconfd/opsiconfd_data/static"
			],
			"runtimeExecutable": "sudo",
			"type": "node",
			"cwd": "${workspaceFolder}/../docker/backend/opsiconfd",
		},
		{
			"name": "Python: Attach",
			"type": "python",
			"request": "attach",
			"connect": {
				"host": "localhost",
				"port": 5678
			}
		}
	],
	"inputs": [
		{
			"id": "loglevel",
			"type": "promptString",
			"description": "Set LogLevel Stderr.",
			"default": "5"
		},
		{
			"id": "loglevelfile",
			"type": "promptString",
			"description": "Set LogLevel File.",
			"default": "5"
		},
		{
			"id": "worker",
			"type": "promptString",
			"description": "Number of opsiconfd worker to start",
			"default": "1"
		},
		{
			"id": "options",
			"type": "promptString",
			"description": "other options",
			"default": "start"
		}
	]
}