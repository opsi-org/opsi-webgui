{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "opsiconfd default",
			"type": "debugpy",
			"request": "launch",
			"module": "opsiconfd",
			"args": [
				"--workers=1",
				"--log-level=5",
				"--log-level-stderr=5",
				"--log-mode=redis",
				"--addon-dirs=/workspace/backend/addon",
				"--static-dir=/workspace/docker/backend/opsiconfd/opsiconfd_data/static",
			],
			"sudo": true,
			"justMyCode": false
		},
		{
			"name": "opsiconfd",
			"type": "debugpy",
			"request": "launch",
			"module": "opsiconfd",
			"args": [
				"--workers=${input:worker}",
				"--log-level-stderr=${input:loglevel}",
				"--log-level-file=${input:loglevelfile}",
				"--addon-dirs=/workspace/backend/addon",
				"--static-dir=/workspace/docker/backend/opsiconfd/opsiconfd_data/static"
			],
			"sudo": true,
		},
		{ // to restart sometimes needs to be run twice (script tries to kill opsiconfd processes)
			"name": "opsiconfd uv",
			"outputCapture": "std",
			"request": "launch",
			"runtimeArgs": [
				"-E",
				"/workspace/backend/scripts/start_opsiconfd.sh"
			],
			"runtimeExecutable": "sudo",
			"type": "node",
			"cwd": "${workspaceFolder}/../docker/backend/opsiconfd",
			"env": {
				"PYTHONPATH": "/workspace/backend"
			}
		}
	],
	"inputs": [
		{
			"id": "loglevel",
			"type": "promptString",
			"description": "Set LogLevel Stderr.",
			"default": "5"
		},
		{
			"id": "loglevelfile",
			"type": "promptString",
			"description": "Set LogLevel File.",
			"default": "5"
		},
		{
			"id": "worker",
			"type": "promptString",
			"description": "Number of opsiconfd worker to start",
			"default": "1"
		},
		{
			"id": "options",
			"type": "promptString",
			"description": "other options",
			"default": "start"
		}
	]
}