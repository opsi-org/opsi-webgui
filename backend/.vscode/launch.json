{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "opsiconfd",
			"type": "debugpy",
			"request": "launch",
			"program": "/workspace/docker/backend/_run_opsiconfd.py",
			"sudo": true,
			"justMyCode": false,
			"envFile": "${workspaceFolder}/.env",
			"env": {
				"PYDEVD_DISABLE_FILE_VALIDATION": "1",
			},
			"subProcess": true,
			//"console": "integratedTerminal"
		},
		{
			"name": "webgui",
			"outputCapture": "std",
			"request": "launch",
			"cwd": "${workspaceFolder}/frontend",
			"preLaunchTask": "npm run dev",
			"type": "node"
		},
	],
	"inputs": [
		{
			"id": "loglevel",
			"type": "promptString",
			"description": "Set LogLevel Stderr.",
			"default": "5"
		},
		{
			"id": "loglevelfile",
			"type": "promptString",
			"description": "Set LogLevel File.",
			"default": "5"
		},
		{
			"id": "worker",
			"type": "promptString",
			"description": "Number of opsiconfd worker to start",
			"default": "1"
		},
		{
			"id": "options",
			"type": "promptString",
			"description": "other options",
			"default": "start"
		}
	]
}