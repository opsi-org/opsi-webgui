{
  "configurations": [
    {
      // Webgui
      "cwd": "${workspaceFolder}/frontend",
      "name": "webgui",
      "outputCapture": "std",
      "request": "launch",
      "runtimeArgs": ["run-script", "dev", "--trace-warnings"],
      "runtimeExecutable": "npm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      // Webgui-Storybook
      "cwd": "${workspaceFolder}/frontend",
      "name": "webgui-storybook",
      "outputCapture": "std",
      "request": "launch",
      "runtimeArgs": ["run-script", "story:dev"],
      "runtimeExecutable": "npm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    }
  ],
  "version": "0.2.0"
}
